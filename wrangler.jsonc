{
  "$schema": "https://unpkg.com/wrangler@4.158.0/config-schema.json",
  "name": "portifolio",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.ts",
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "portfolio-leads",
      "database_id": "187c9ce6-ab8c-45e5-b9de-28869bcf7993",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LEADS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://portifolio.jonathandiasfelipe.workers.dev"
  }
}
